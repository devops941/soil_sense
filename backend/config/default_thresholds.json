  "nutrient_index": {
    "description": "Nutrient Index (NI) is computed separately for each of N, P, and K across a set of soil samples from a field or survey unit.",
    "formula": "NI = (1*n_low + 2*n_medium + 3*n_high) / n_total",
    "formula_variables": {
      "n_low": "count of samples classified as Low for the nutrient",
      "n_medium": "count of samples classified as Medium for the nutrient",
      "n_high": "count of samples classified as High for the nutrient",
      "n_total": "total number of samples in the set"
    },
    "cutoffs": {
      "low": "< 1.67",
      "medium": "1.67 - 2.33",
      "high": "> 2.33"
    },
    "source": "Parker (1951); Rammoorthy & Bajaj (1969), Fertilizer News 14(8):24-26",
    "note": "No ICAR-prescribed single composite per-sample fertility score exists; N, P, K reported as three separate indices."
  }
